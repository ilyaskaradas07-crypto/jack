# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Telegram Bot API Token from @BotFather (e.g., 123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ)
# Kept strictly server-side, never exposed to client/browser.
TELEGRAM_BOT_TOKEN=""

# TELEGRAM_CHAT_ID: Telegram Chat ID or Channel ID where new visitor alerts are received (e.g., 123456789 or -100123456789)
TELEGRAM_CHAT_ID=""

# ALLOWED_ORIGIN: Optional origin allowed to submit visitor notifications (e.g., https://triporaalanya.com). Leave empty to allow all.
ALLOWED_ORIGIN=""

# RESERVATION_TARGET_EMAIL: Email address where all new tour reservations are automatically forwarded
RESERVATION_TARGET_EMAIL="ilyaskaradas07@hotmail.com"

# SMTP Settings for sending automated email confirmations (optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
